# Copy this file to .env.local and fill in the keys. Keys stay on the server
# (app/api/*); never commit .env.local. Each provider has one job (CLAUDE.md
# §7.5). Keys are checked at startup: a malformed key stops the server. A
# missing key turns off its job, which falls back to written hints or the
# browser's speech; set ANOMALY_REQUIRE_KEYS=1 to make missing keys fatal too.
# ANOMALY_REQUIRE_KEYS=1

# Ask Ano answers. Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Ano's voice. ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Rate limits and answer cache. Upstash Redis (free tier): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ASK_ANO_DAILY_CAP=300

# Eval grading only (tests/ask-ano.eval.ts, ASK_ANO_EVAL=real), never at runtime.
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Proposed jobs, not wired up yet (see HANDOFF.md, "Provider-to-task mapping").
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
