# Ask Ano (the only AI feature). Copy this file to .env.local and fill in any
# keys you have. Every provider is optional and free-tier friendly; Ask Ano
# tries them in this order and falls back to the written hints if none work.
# Keys stay on the server (app/api/ask-ano). Never commit .env.local.

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional extras
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# OpenRouter: https://openrouter.ai/keys (pick a current free model, e.g. one ending in ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
