  "tryAtHome": {
    "title": "Check the UV on a cloudy day",
    "steps": [
      "With an adult, open a weather app that shows the UV index.",
      "Check it on a sunny day, then on a cloudy day.",
      "Or put UV-sensitive beads by a window and watch them change colour."
    ],
    "watch": "Is the UV index still above zero when it's cloudy?",
    "safety": "Do this with an adult. Never look straight at the sun."
  }
